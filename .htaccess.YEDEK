# EĞER 500 HATASI ALIYORSANIZ:
# 1. .htaccess dosyasını geçici olarak silin veya .htaccess.kapali olarak adlandırın
# 2. Doğrudan index.php, test.php gibi dosyaları açın
# 3. PHP hatası mı, .htaccess hatası mı anlayın

# Minimal .htaccess - 500 Hatası Çözümü

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /hafriyat/

# Admin ve assets'i atla
RewriteCond %{REQUEST_URI} ^/hafriyat/admin [NC,OR]
RewriteCond %{REQUEST_URI} ^/hafriyat/assets [NC]
RewriteRule ^ - [L]

# PHP uzantısını kaldır (sadece dosya varsa)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
</IfModule>
