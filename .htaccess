# Kayseri Emir Hafriyat - .htaccess
# Mod Rewrite Engine'i aç
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # HTTPS zorla (opsiyonel - istemezsen yorum satırı yap)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # www'lu/www'suz yönlendirme (istemezsen yorum satırı yap)
    # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Mevcut dosya veya dizinlerse dokunma
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Blog detay sayfası: /blog/slug → blog-single.php?slug=slug
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog-single.php?slug=$1 [L,QSA]

    # Hizmet detay sayfası: /hizmet/slug → hizmet-single.php?slug=slug
    RewriteRule ^hizmet/([a-z0-9-]+)/?$ hizmet-single.php?slug=$1 [L,QSA]

    # Blog liste sayfası: /blog → blog.php
    RewriteRule ^blog/?$ blog.php [L,QSA]

    # Hizmetler liste sayfası: /hizmetler → hizmetler.php
    RewriteRule ^hizmetler/?$ hizmetler.php [L,QSA]

    # Hakkımızda: /hakkimizda → hakkimizda.php
    RewriteRule ^hakkimizda/?$ hakkimizda.php [L,QSA]

    # İletişim: /iletisim → iletisim.php
    RewriteRule ^iletisim/?$ iletisim.php [L,QSA]

    # Galeri: /galeri → galeri.php
    RewriteRule ^galeri/?$ galeri.php [L,QSA]

    # Projeler: /projeler → projeler.php
    RewriteRule ^projeler/?$ projeler.php [L,QSA]

    # Admin paneli .php uzantısız erişim (opsiyonel)
    # RewriteCond %{REQUEST_URI} ^/admin/
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteRule ^admin/([^/]+)/?$ admin/$1.php [L,QSA]
</IfModule>

# PHP ayarları
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Dosya uzantılarını gizle (güvenlik)
Options -Indexes

# Cache ayarları
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Gzip sıkıştırma
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# Güvenlik başlıkları
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# .htaccess ve diğer hassas dosyaları koruma
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# config.php dosyasına erişimi engelle
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# database.sql dosyasına erişimi engelle
<Files "database.sql">
    Order allow,deny
    Deny from all
</Files>
