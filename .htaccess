# Kayseri Emir Hafriyat - SEF URL

RewriteEngine On

# ============================================
# DURUM 1: Root dizinde ise bu satırı kullanın
# RewriteBase /
# ============================================

# ============================================
# DURUM 2: Alt klasörde ise bu satırı kullanın
RewriteBase /hafriyat/
# ============================================

# Admin ve assets klasörlerini atla
RewriteCond %{REQUEST_URI} /admin [NC,OR]
RewriteCond %{REQUEST_URI} /assets [NC]
RewriteRule ^ - [L]

# .php uzantısını kaldır
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Blog detay sayfası
RewriteRule ^blog/([a-z0-9-]+)$ blog-single.php?slug=$1 [L,QSA]

# Hizmet detay sayfası
RewriteRule ^hizmet/([a-z0-9-]+)$ hizmet-single.php?slug=$1 [L,QSA]
