# Kayseri Emir Hafriyat - SEF URL

RewriteEngine On
RewriteBase /hafriyat/

# Admin ve assets klasörlerini atla
RewriteCond %{REQUEST_URI} ^/hafriyat/admin [NC,OR]
RewriteCond %{REQUEST_URI} ^/hafriyat/assets [NC]
RewriteRule ^ - [L]

# .php uzantısını kaldır
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Blog detay sayfası
RewriteRule ^blog/([a-z0-9-]+)$ blog-single.php?slug=$1 [L,QSA]

# Hizmet detay sayfası
RewriteRule ^hizmet/([a-z0-9-]+)$ hizmet-single.php?slug=$1 [L,QSA]
